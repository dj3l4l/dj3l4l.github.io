---
const links = [
  ['Home', '/'],
  ['About', '/about/'],
  ['Posts', '/posts/'],
  ['Projects', '/projects/'],
  ['Tags', '/tags/'],
];
---

<nav class="site-nav" aria-label="Site navigation">
  <details>
    <summary aria-label="Open menu">Menu</summary>
    <ul>
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </details>
</nav>
