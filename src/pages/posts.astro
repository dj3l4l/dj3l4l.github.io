---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.project))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="All Posts">
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB')}</time>
          {post.data.experimental && <span>Experiment</span>}
        </div>
        <h2><a href={`/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.excerpt}</p>
      </li>
    ))}
  </ul>
</PageLayout>
