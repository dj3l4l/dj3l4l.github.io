---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
  date?: Date;
  article?: boolean;
}

const { title, description, backHref = '/', backLabel = 'Back home', date, article = false } = Astro.props;
const formattedDate = date?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout title={title} description={description} article={article}>
  <main id="main-content" class="page-shell">
    <article class="paper">
      <header class="page-heading">
        {article && <p class="eyebrow">Essay</p>}
        <h1>{title}</h1>
        {date && <time datetime={date.toISOString()}>{formattedDate}</time>}
        <div><a class="back-link" href={backHref} aria-label={backLabel}>←</a></div>
      </header>
      <div class="prose"><slot /></div>
    </article>
  </main>
</BaseLayout>
